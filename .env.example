# GPU Port Collectors - Environment Configuration
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: DO NOT commit .env to git (it's already in .gitignore)
#
# See docs/CONFIGURATION.md for complete configuration guide

# ============================================================================
# GPU Provider API Keys (REQUIRED for collection)
# ============================================================================

# RunPod
RUNPOD_API_KEY=your_runpod_api_key_here

# Lambda Labs
LAMBDA_API_KEY=your_lambda_api_key_here

# Cudo Compute
CUDO_API_KEY=your_cudo_api_key_here

# Novita AI
NOVITA_API_KEY=your_novita_api_key_here


# ============================================================================
# HTTP Export Configuration (OPTIONAL)
# ============================================================================
# These are used when exporting data to HTTP endpoints
# Reference in export YAML configs using ${VARIABLE_NAME} syntax

# Authentication tokens for HTTP endpoints
# API_TOKEN=your_secret_api_token_here

# Custom webhook URL
# WEBHOOK_URL=https://hooks.example.com/gpu-data


# ============================================================================
# S3/R2 Export Configuration (OPTIONAL)
# ============================================================================
# Only required if exporting to S3-compatible storage without IAM roles

# AWS/Cloudflare R2 credentials
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Optional: AWS session token for temporary credentials
# AWS_SESSION_TOKEN=your_session_token_here


# ============================================================================
# Observability (OPTIONAL)
# ============================================================================
# Honeycomb.io integration for OpenTelemetry traces and logs

# HONEYCOMB_API_KEY=your_honeycomb_api_key_here